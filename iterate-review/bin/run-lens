#!/usr/bin/env python3
"""run-lens — compose one lens input, invoke Codex, validate the response.

Part of the iterate-review runner set (stdlib-only, Python >= 3.9); see
docs/runner-scripts-artifact-hygiene-2026-08-06.md. The runner composes and
invokes; it never folds, never writes pass logs, never decides.

Standalone exit contract: 0 = valid response published; 2 = response rejected
(patch markers or structural failure); 1 = invocation/orchestration error.
Standalone invocations are debug tools: they take no lock and write only to
the isolated state/<scope-hash>/debug/ namespace — never to published
pass-N.* state, so a standalone run during a live run-pass cannot overwrite
or interleave published artifacts. The machine-readable result is printed to
stdout.
"""
import sys

MIN_PYTHON = (3, 9)
if sys.version_info < MIN_PYTHON:
    sys.stderr.write(
        "run-lens: Python %d.%d+ required, found %d.%d — see README (Prerequisites)\n"
        % (MIN_PYTHON + sys.version_info[:2])
    )
    sys.exit(1)

import argparse
import json
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import review_runner as rr  # noqa: E402

EXIT_OK = 0
EXIT_ERROR = 1
EXIT_REJECTED = 2


def build_parser():
    p = argparse.ArgumentParser(
        prog="run-lens",
        description=(
            "Compose one lens input, invoke Codex read-only, validate the "
            "response. Standalone runs are debug-only: no lock, artifacts "
            "under state/<scope-hash>/debug/. Exit 0 = valid response, "
            "2 = rejected (patch markers / structural failure), 1 = error."
        ),
    )
    p.add_argument("--diff", required=True, type=Path, help="path to the scope diff file")
    p.add_argument("--intent", required=True, type=Path, help="path to the intent file")
    p.add_argument("--lens", required=True, help="lens id (senior-dev | security | qa)")
    p.add_argument("--scope-tag", required=True, help="scope tag (with the resolved log path, keys the state dir)")
    p.add_argument("--log-path", type=Path, default=None,
                   help="pass-log override; default is <repo-root>/docs/reviews/code-review-<scope-tag>.md")
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)

    # Same trusted boundary as run-pass: repo root + skill state root.
    repo_root, _ = rr.shared.resolve_repo_root()
    boundaries = [repo_root, rr.STATE_ROOT]
    try:
        diff_path = rr.shared.ensure_trusted_path(args.diff, boundaries, "--diff")
        intent_path = rr.shared.ensure_trusted_path(args.intent, boundaries, "--intent")
        if args.log_path is not None:
            rr.shared.ensure_trusted_path(args.log_path, [repo_root], "--log-path")
    except rr.shared.TrustedPathError as exc:
        sys.stderr.write(f"run-lens: {exc}\n")
        return EXIT_ERROR

    try:
        diff_text = diff_path.read_text(encoding="utf-8")
        intent_text = intent_path.read_text(encoding="utf-8")
    except OSError as exc:
        sys.stderr.write(f"run-lens: {exc}\n")
        return EXIT_ERROR

    log_path, warnings = rr.resolve_log_path(args.scope_tag, args.log_path)
    shash = rr.scope_hash(args.scope_tag, log_path)
    state_dir = rr.STATE_ROOT / shash

    try:
        prior = rr.read_prior_passes(log_path)
        input_path, response_path = rr.debug_paths(state_dir, args.lens)
        input_path.parent.mkdir(parents=True, exist_ok=True)
        entry = rr.run_one_lens(args.lens, intent_text, diff_text, prior,
                                input_path, response_path)
    except rr.CompositionError as exc:
        sys.stderr.write(f"run-lens: {exc}\n")
        return EXIT_ERROR

    result = {
        "lens": args.lens,
        "scope_hash": shash,
        "log_path": str(log_path),
        "warnings": warnings,
        "input_path": str(input_path),
        **entry,
    }
    print(json.dumps(result, indent=2, sort_keys=True))
    if entry["status"] == "ok":
        return EXIT_OK
    if entry["status"] == "rejected":
        return EXIT_REJECTED
    return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main())
