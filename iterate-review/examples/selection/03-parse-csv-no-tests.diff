 import csv


+def parse_csv_rows(path, delimiter=","):
+    rows = []
+    with open(path, newline="") as fh:
+        reader = csv.reader(fh, delimiter=delimiter)
+        header = next(reader, None)
+        if header is None:
+            return rows
+        for line in reader:
+            rows.append(dict(zip(header, line)))
+    return rows
