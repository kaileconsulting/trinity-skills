--- a/src/Foo.TS
+++ b/src/Foo.TS
@@ -1,2 +1,12 @@
 export const SCALE = 100;

+
+export function normalize(values: number[]): number[] {
+  if (values.length === 0) {
+    return [];
+  }
+  const largest = Math.max(...values);
+  if (largest === 0) {
+    return values.map(() => 0);
+  }
+  return values.map((v) => (v / largest) * SCALE);
+}
